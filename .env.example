# cmemory 环境配置示例
# 复制此文件为 .env 并填写实际值

# ============================================
# OpenAI API 配置 (用于 QA、Judge 和 Embedding)
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 可选: 使用其他 OpenAI 兼容服务
# OPENAI_API_BASE=https://api.deepseek.com/v1

# ============================================
# 模型配置 - LLM
# ============================================
QA_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# ============================================
# 模型配置 - Embedding
# ============================================
# Embedding 模型用于将文本转为向量，存储到向量数据库

# 方式 1: OpenAI Embedding (推荐)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# 方式 2: OpenAI 大模型
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMS=3072

# 方式 3: 本地 HuggingFace 模型 (不需要 API Key)
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=/path/to/models/all-MiniLM-L6-v2
# EMBEDDING_DIMS=384

# ============================================
# Mem0 配置 (如果使用 Mem0 Engine)
# ============================================
# Mem0 使用同样的 OpenAI API Key
# MEM0_API_KEY=sk-your-mem0-api-key  # 如果使用 Mem0 Cloud API

# Vector Store 配置
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_PATH=.memory_data/qdrant

# ============================================
# Zep 配置 (如果使用 Zep Engine)
# ============================================
# ZEP_API_KEY=your-zep-api-key
# ZEP_API_URL=https://api.getzep.com

# ============================================
# Letta/MemGPT 配置 (如果使用 Letta Engine)
# ============================================
# LETTA_API_KEY=your-letta-api-key
# LETTA_API_URL=https://api.letta.com

# ============================================
# 存储配置
# ============================================
STORAGE_DIR=.memory_data

# ============================================
# 日志级别
# ============================================
LOG_LEVEL=INFO